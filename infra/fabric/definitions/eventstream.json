    "properties": {"inputSerialization": {"type": "Json", "properties": {"encoding": "UTF8"}}}
  }],
  "streams": [{
    "name": "ProcessEventsStream",
    "type": "DefaultStream",
    "properties": {},
    "inputNodes": [{"name": "CameraEvents"}]
  }],
  "operators": [],
