// ==============================================================================
// Microsoft Fabric KQL Queries for Real-Time Intelligence & Dashboards
// ==============================================================================

// Query 1: Digital Twin Current State with Cell & Plant Metadata (Join with Reference)
CurrentPalletOccupancy
| join kind=leftouter (
    PalletPositions
    | join kind=inner Cells on cellId
    | join kind=inner Plants on plantId
) on $left.subjectId == $right.palletPositionId
| project
    Plant = plantName,
    Cell = cellName,
    Position = positionName,
    SubjectId = subjectId,
    Status = iff(isOccupied, "Occupied", "Empty"),
    Confidence = confidence,
    LastSeen = capturedAt,
    CameraSource = sourceId,
    Model = model

// Query 2: KPI Counts (Total Monitored, Occupied, Empty)
CurrentPalletOccupancy
| summarize
    TotalPositions = count(),
    OccupiedCount = countif(isOccupied == true),
    EmptyCount = countif(isOccupied == false),
    OccupancyRate = round(100.0 * countif(isOccupied == true) / count(), 1)

// Query 3: Transition Timeline (Last 24 hours of transitions across cells)
ProcessEventsRaw
| where observationType == "PalletPresent" and capturedAt > ago(24h)
| order by capturedAt desc
| project
    Timestamp = capturedAt,
    Subject = subjectId,
    Transition = iff(tobool(value) == true, "Pallet Placed (Occupied)", "Pallet Removed (Empty)"),
    Confidence = confidence,
    Source = sourceId

// Query 4: Ingestion Latency Metric (Edge capture time to Ingestion time in seconds)
ProcessEventsRaw
| where capturedAt > ago(1h)
| extend LatencySeconds = datetime_diff('second', ingestionTime, capturedAt)
| summarize
    AvgLatencySeconds = avg(LatencySeconds),
    MaxLatencySeconds = max(LatencySeconds),
    p95LatencySeconds = percentile(LatencySeconds, 95)
    by bin(capturedAt, 5m)
| render timechart
