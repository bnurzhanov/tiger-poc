{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/process-event-v1.json",
  "title": "ProcessEvent",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "sourceId",
    "subjectId",
    "observationType",
    "value",
    "unit",
    "confidence",
    "capturedAt",
    "producedAt",
    "publishedAt",
    "provider",
    "model",
    "source"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\..+" },
    "eventId": { "type": "string", "minLength": 1 },
    "eventType": { "const": "ProcessEvent" },
    "sourceId": { "type": "string", "minLength": 1 },
    "subjectId": { "type": "string", "minLength": 1 },
    "observationType": { "type": "string", "minLength": 1 },
    "value": { "type": ["string", "number", "boolean", "null"] },
    "unit": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "capturedAt": { "type": "string", "format": "date-time" },
    "producedAt": { "type": "string", "format": "date-time" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "sensitive": { "type": "object" }
  }
}
